@startuml CentralAcquisition_Dynamic
title Central Acquisition - Dynamic Software Design

' =============================================================
' Two dynamic views of the CentralAcquisition firmware:
'   1. State machine  - top-level behavior driven by serial events
'   2. Sequence        - end-to-end message flow during an exam
' Source of truth: CentralAcquisition/src/main.cpp
' =============================================================

' -------------------------------------------------------------
' 1) STATE MACHINE
' -------------------------------------------------------------
state "Central Acquisition - State Machine" as SM {

  [*] --> STATE_DISCONNECTED

  state STATE_DISCONNECTED {
    STATE_DISCONNECTED : entry / ignore exam events
    STATE_DISCONNECTED : on EV_CONNECT_MSG_RECEIVED \n  -> writeMsgToSerialPort(CONNECT_MSG)
  }

  state STATE_CONNECTED {
    [*] --> EXAM_IDLE

    state EXAM_IDLE
    state EXAM_SINGLE_SHOT
    state EXAM_SERIES
    state EXAM_SERIES_WITH_MOTION
    state EXAM_FLUORO

    EXAM_IDLE              : do / sendMessage(SLAVE_1, MSG_START, EXAM_TYPE_NONE)
    EXAM_IDLE              : do / GRNLED=ON, REDLED=OFF
    EXAM_SINGLE_SHOT       : do / sendMessage(SLAVE_1, MSG_START, EXAM_TYPE_SINGLE_SHOT)
    EXAM_SERIES            : do / sendMessage(SLAVE_1, MSG_START, EXAM_TYPE_SERIES)
    EXAM_SERIES_WITH_MOTION: do / sendMessage(SLAVE_1, MSG_START, EXAM_TYPE_SERIES_WITH_MOTION)
    EXAM_FLUORO            : do / sendMessage(SLAVE_1, MSG_START, EXAM_TYPE_FLUORO)

    EXAM_IDLE              --> EXAM_SINGLE_SHOT        : EV_EXAM_SINGLE_SHOT        \n (EXAM:1)
    EXAM_IDLE              --> EXAM_SERIES             : EV_EXAM_SERIES             \n (EXAM:2)
    EXAM_IDLE              --> EXAM_SERIES_WITH_MOTION : EV_EXAM_SERIES_WITH_MOTION \n (EXAM:3)
    EXAM_IDLE              --> EXAM_FLUORO             : EV_EXAM_FLUORO             \n (EXAM:4)

    EXAM_SINGLE_SHOT       --> EXAM_IDLE : EV_IDLE (EXAM:0)
    EXAM_SERIES            --> EXAM_IDLE : EV_IDLE (EXAM:0)
    EXAM_SERIES_WITH_MOTION--> EXAM_IDLE : EV_IDLE (EXAM:0)
    EXAM_FLUORO            --> EXAM_IDLE : EV_IDLE (EXAM:0)
  }

  STATE_DISCONNECTED --> STATE_CONNECTED    : EV_CONNECT_MSG_RECEIVED \n / echo "$CONNECT#"
  STATE_CONNECTED    --> STATE_DISCONNECTED : EV_DISCONNECT_MSG_RECEIVED \n / echo "$DISCONNECT#"
}

note right of STATE_DISCONNECTED
  Concurrent activity (in loop()):
  - every 5000 ms a "$DOSE:<n>#"
    frame is pushed on Serial to
    the Patient Admin (placeholder
    until real dose telemetry exists).
end note

@enduml


@startuml CentralAcquisition_ExamSequence
title Central Acquisition - Exam Sequence (e.g. SINGLE_SHOT)

skinparam sequenceMessageAlign center
autonumber

actor "Operator"        as OP
participant "Patient Admin\n(PC / host)"            as PA
participant "Central Acquisition\n(I2C master, Arduino)" as CA
participant "X-ray Generator\n(I2C slave_1, Arduino)"   as XG
participant "Dose Admin\n(serial sink on PA)"        as DA

== Link establishment ==
OP -> PA  : start session
PA -> CA  : "$CONNECT#"               (Serial, framed)
note right of CA
  getEvent() -> EV_CONNECT_MSG_RECEIVED
  handleEvent(): DISCONNECTED -> CONNECTED
end note
CA -> PA  : "$CONNECT#"               (ack via echo)

== Exam selection (CONNECTED state) ==
OP -> PA  : select "Single shot"
PA -> CA  : "$EXAM:1#"
note right of CA
  getEvent() -> EV_EXAM_SINGLE_SHOT
  EXAM_SINGLE_SHOT(): REDLED=ON
end note

== I2C transaction with retries ==
loop up to MAX_RETRIES (3)
  CA -> XG : Wire.beginTransmission(SLAVE_1)\nwrite(MSG_START)\nwrite(EXAM_TYPE_SINGLE_SHOT)\nendTransmission()
  activate XG
  XG -> XG : onReceive(): handleMessage(MSG_START)\n run SAN-pin sampled exposure loop
  CA -> CA : delay(100 ms)
  CA -> XG : Wire.requestFrom(SLAVE_1, 2)
  alt slave ready
    XG --> CA : { ACK, payload }
    deactivate XG
    note right of CA: sendMessage() returns true
  else slave busy
    XG --> CA : { NAK, 0x00 }
    note right of CA: keep polling within this retry
  else no response
    XG --> CA : (timeout / 0 bytes)
    note right of CA: log "NO RESPONSE" and retry
  end
  break on ACK
  end
end

== Dose telemetry (concurrent, every 5 s) ==
CA -->> PA : "$DOSE:<n>#"
PA -> DA  : update dose ledger

== Exam end / shutdown ==
PA -> CA  : "$EXAM:0#"   (return to idle)
CA -> XG  : MSG_START, EXAM_TYPE_NONE
XG --> CA : ACK
PA -> CA  : "$DISCONNECT#"
CA -> PA  : "$DISCONNECT#"            (ack via echo)
note over CA: state -> DISCONNECTED

@enduml
