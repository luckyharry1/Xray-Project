@startuml CentralAcquisition_Sequence
title Central Acquisition - Exam Sequence (e.g. SINGLE_SHOT)

skinparam sequenceMessageAlign center
autonumber

actor       "Operator"                                 as OP
participant "Patient Admin\n(PC / host)"               as PA
participant "Central Acquisition\n(I2C master)"        as CA
participant "X-ray Generator\n(I2C slave_1)"           as XG
participant "Dose Admin\n(serial sink on PA)"          as DA

== Link establishment ==
OP -> PA : start session
PA -> CA : $CONNECT#                  (Serial, framed)
note right of CA
  getEvent() -> EV_CONNECT_MSG_RECEIVED
  handleEvent(): DISCONNECTED -> CONNECTED
end note
CA -> PA : $CONNECT#                  (ack via echo)

== Exam selection (CONNECTED state) ==
OP -> PA : select "Single shot"
PA -> CA : $EXAM:1#
note right of CA
  getEvent() -> EV_EXAM_SINGLE_SHOT
  EXAM_SINGLE_SHOT(): REDLED=ON
end note

== I2C transaction with retries ==
loop up to MAX_RETRIES (3), exits early on ACK
  CA -> XG : Wire.beginTransmission(SLAVE_1)\nwrite(MSG_START)\nwrite(EXAM_TYPE_SINGLE_SHOT)\nendTransmission()
  activate XG
  XG -> XG : onReceive(): handleMessage(MSG_START)\nrun SAN-pin sampled exposure loop
  CA -> CA : delay(100 ms)
  CA -> XG : Wire.requestFrom(SLAVE_1, 2)
  alt slave ready
    XG --> CA : ACK + payload
    deactivate XG
    note right of CA: sendMessage() returns true,\nloop exits
  else slave busy
    XG --> CA : NAK + 0x00
    note right of CA: keep polling within this retry
  else no response
    XG --> CA : (timeout / 0 bytes)
    note right of CA: log "NO RESPONSE",\nfall through to next retry
  end
end

== Dose telemetry (concurrent, every 5 s) ==
CA -->> PA : $DOSE:<n>#
PA -> DA   : update dose ledger

== Exam end / shutdown ==
PA -> CA : $EXAM:0#                   (return to idle)
CA -> XG : MSG_START, EXAM_TYPE_NONE
XG --> CA : ACK
PA -> CA : $DISCONNECT#
CA -> PA : $DISCONNECT#               (ack via echo)
note over CA: state -> DISCONNECTED

@enduml
